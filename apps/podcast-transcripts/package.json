{
  "name": "podcast-transcripts",
  "version": "1.0.0",
  "description": "Download existing transcripts for financial podcasts using Playwright",
  "main": "index.js",
  "type": "commonjs",
  "scripts": {
    "download": "node index.js",
    "download:ms": "node index.js --podcast morgan-stanley",
    "download:gs": "node index.js --podcast goldman-sachs",
    "install:browsers": "npx playwright install chromium"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "pdf-parse": "^1.1.1",
    "playwright": "^1.50.0"
  }
}
