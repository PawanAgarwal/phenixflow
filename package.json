{
  "name": "phenixflow",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo for Project phenixflow apps, shared market-data packages, and ClickHouse infrastructure",
  "main": "apps/flow-api/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node apps/flow-api/server.js",
    "flow:start": "node apps/flow-api/server.js",
    "ingest:start": "node apps/flow-api/scripts/ingest-worker.js",
    "options:init-layout": "node apps/flow-api/scripts/options/init-options-layout.js",
    "options:download:top100-30d": "node apps/flow-api/scripts/backfill/backfill-options-top100-30d.js",
    "oi:sync": "node apps/flow-api/scripts/oi/sync-gov-oi.js",
    "rules:activate": "node apps/flow-api/scripts/rules/activate-rule-version.js",
    "sigscore:calibrate": "node apps/flow-api/scripts/sigscore/calibrate-unusual.js",
    "sigscore:calibrate:swing": "node apps/flow-api/scripts/sigscore/calibrate-swing.js",
    "clickhouse:install": "bash infra/clickhouse/scripts/install-clickhouse.sh status",
    "clickhouse:start": "bash infra/clickhouse/scripts/start-clickhouse.sh",
    "clickhouse:stop": "bash infra/clickhouse/scripts/stop-clickhouse.sh",
    "clickhouse:status": "bash infra/clickhouse/scripts/status-clickhouse.sh",
    "clickhouse:sofr:sync": "node infra/clickhouse/scripts/sync-sofr-daily.js --refresh 1 --years 3",
    "clickhouse:calculated-greeks:backfill": "node infra/clickhouse/scripts/backfill-calculated-greeks.js",
    "clickhouse:calculated-greeks:backfill:parallel": "bash infra/clickhouse/scripts/backfill-calculated-greeks-parallel.sh",
    "clickhouse:move-to-external": "bash infra/clickhouse/scripts/move-clickhouse-to-external.sh",
    "clickhouse:init-schema": "bash infra/clickhouse/scripts/init-options-schema.sh",
    "clickhouse:import:sqlite": "bash infra/clickhouse/scripts/import-from-sqlite.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "backfill:option-trade-quote": "node apps/flow-api/scripts/backfill/backfill-option-trade-quote.js",
    "backfill:clickhouse:historical-days": "node apps/flow-api/scripts/backfill/backfill-clickhouse-historical-days.js",
    "backfill:clickhouse:historical-days:parallel": "bash apps/flow-api/scripts/backfill/backfill-clickhouse-historical-days-parallel.sh",
    "backfill:clickhouse:historical-days:pipeline": "bash apps/flow-api/scripts/backfill/backfill-clickhouse-historical-days-pipeline.sh",
    "backfill:clickhouse:generate-symbol-days": "node apps/flow-api/scripts/backfill/generate-symbol-days-topn-range.js",
    "backfill:clickhouse:range": "bash apps/flow-api/scripts/backfill/run-clickhouse-backfill-range.sh",
    "enrich:option-trades": "node apps/flow-api/scripts/backfill/enrich-option-trades.js",
    "enrich:option-trades:parallel": "bash apps/flow-api/scripts/backfill/enrich-option-trades-parallel.sh",
    "research:option-rr": "node apps/flow-api/scripts/backfill/research-option-rr-strategies.js",
    "vixregime:check": "node projects/vixregime/scripts/check-required-data.js",
    "vixregime:backtest": "node projects/vixregime/scripts/backtest-spx-vix-regime.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "better-sqlite3": "^12.6.2",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "eslint": "^9.20.1",
    "globals": "^15.15.0",
    "supertest": "^7.0.0",
    "vitest": "^3.0.5"
  }
}
