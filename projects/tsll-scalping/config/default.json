  },
  "roots": {
    "historical": "/Volumes/SEC4TB/massive-data/massive",
    "calendar": "/Volumes/SEC4TB/massive-data/calendar/us-equities-options-calendar.json"
  },
  "datasets": {
    "stockTrades": "stock_trades_all",
    "stockBars": "stock_quotes_1m",
    "optionBars": "option_quotes_1m",
    "optionTrades": "option_trades_all"
