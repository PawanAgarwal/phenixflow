{
  "projectName": "tsll-scalping",
  "dataPolicy": {
    "provider": "Massive",
    "allowLegacyDatabase": false,
    "firstHistoricalDate": "2025-01-02"
  },
  "roots": {
    "historical": "/Volumes/SEC4TB/massive-data/massive",
    "liveParquet": "/Volumes/SEC4TB/massive-data/massive-live/parquet/massive",
    "calendar": "/Volumes/SEC4TB/massive-data/calendar/us-equities-options-calendar.json"
  },
  "datasets": {
    "stockTrades": "stock_trades_all",
    "stockBars": "stock_quotes_1m",
    "stockTickQuotes": "stock_quotes_all",
    "optionBars": "option_quotes_1m",
    "optionTrades": "option_trades_all"
  },
  "target": "TSLL",
  "marketSymbols": ["SPY", "QQQ", "TSLA", "TSLL"],
  "optionRoots": {
    "tsll": ["TSL", "TSLL"],
    "tsla": ["TSLA"]
  },
  "session": {
    "timeZone": "America/New_York",
    "extendedOpenMinuteEt": 240,
    "extendedCloseMinuteEt": 1200,
    "regularOpenMinuteEt": 570,
    "regularCloseMinuteEt": 960
  },
  "execution": {
    "barSeconds": 5,
    "costCentsPerSide": 0.5,
    "cooldownBars": 2,
    "noEntryFirstMinutes": 5,
    "noEntryLastMinutes": 5
  },
  "research": {
    "useOptionFeaturesDefault": false,
    "dailyWarmupDays": 35,
    "massiveStockTickQuoteDataset": "us_stocks_sip/quotes_v1",
    "notes": [
      "Tick stock quote flat files are not currently cached locally; stock_quotes_1m is Massive 1-minute aggregate bars, not NBBO tick quotes.",
      "Default strategy grid is no-option and uses prior-day daily context plus intraday TSLL trades."
    ]
  }
}
