  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/Users/pawanagarwal/github/phenixflow/projects/pym-v5-replication/runtime/pym-v5-service.out.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/pawanagarwal/github/phenixflow/projects/pym-v5-replication/runtime/pym-v5-service.err.log</string>
